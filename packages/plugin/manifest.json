{
  "manifestVersion": 5,
  "id": "com.openai.structured-publisher",
  "name": "Structured Publisher",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "structuredPublisherPanel",
      "label": { "default": "Structured Publisher" },
      "minimumSize": { "width": 280, "height": 300 },
      "preferredDockedSize": { "width": 340, "height": 480 },
      "preferredFloatingSize": { "width": 360, "height": 520 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}
