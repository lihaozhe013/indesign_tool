const { app, SaveOptions } = require("indesign");

// Namespaced key aligned with the existing template scan. Persistence is a
// separate probe; this run only covers same-session behavior.
const KEY = "com.publisher.role";

function read(readValue, fallback) {
  try {
    const value = readValue();
    return value === undefined || value === null ? fallback : value;
  } catch (_error) {
    return fallback;
  }
}

function items(collection) {
  const output = [];
  for (let index = 0; index < collection.length; index += 1) {
    output.push(typeof collection.item === "function" ? collection.item(index) : collection[index]);
  }
  return output;
}

const result = {
  probeVersion: 2,
  capability: "script-labels-in-memory",
  hostVersion: String(app.version),
  domVersion: String(app.scriptPreferences.version),
  openDocumentCountBefore: app.documents.length,
  labelKey: KEY,
  success: false
};

let scratchDocument;

try {
  scratchDocument = app.documents.add();
  const page = scratchDocument.pages.item(0);
  const frameA = page.textFrames.add({ geometricBounds: [36, 36, 108, 300], contents: "A" });
  const frameB = page.textFrames.add({ geometricBounds: [120, 36, 192, 300], contents: "B" });
  const frameC = page.textFrames.add({ geometricBounds: [204, 36, 276, 300], contents: "C" });
  frameA.name = "ProbeUnique";
  frameB.name = "ProbeDup";
  frameC.name = "ProbeDup";

  const paragraphStyle = scratchDocument.paragraphStyles.add({ name: "Folio Probe Labeled Body" });
  const characterStyle = scratchDocument.characterStyles.add({ name: "Folio Probe Labeled Emphasis" });
  const objectStyle = scratchDocument.objectStyles.add({ name: "Folio Probe Labeled Frame" });

  scratchDocument.insertLabel(KEY, "probe-document");
  page.insertLabel(KEY, "probe-page-article");
  frameA.insertLabel(KEY, "probe-hero-title");
  frameB.insertLabel(KEY, "probe-dup-slot");
  frameC.insertLabel(KEY, "probe-dup-slot");
    paragraphStyle.insertLabel(KEY, "probe-style-body");
    characterStyle.insertLabel(KEY, "probe-style-emphasis");
    objectStyle.insertLabel(KEY, "probe-style-frame");
    frameA.label = "Probe Display Label";

    const SECOND_KEY = "com.publisher.other";
    frameA.insertLabel(SECOND_KEY, "probe-other");
    result.keyIsolation = String(read(function () { return frameA.extractLabel(KEY); }, "")) === "probe-hero-title"
      && String(read(function () { return frameA.extractLabel(SECOND_KEY); }, "")) === "probe-other"
      && String(read(function () { return frameB.extractLabel(SECOND_KEY); }, "")) === "";

  const roundTrip = {
    document: String(read(function () { return scratchDocument.extractLabel(KEY); }, "")),
    page: String(read(function () { return page.extractLabel(KEY); }, "")),
    textFrameA: String(read(function () { return frameA.extractLabel(KEY); }, "")),
    textFrameB: String(read(function () { return frameB.extractLabel(KEY); }, "")),
    textFrameC: String(read(function () { return frameC.extractLabel(KEY); }, "")),
    paragraphStyle: String(read(function () { return paragraphStyle.extractLabel(KEY); }, "")),
    characterStyle: String(read(function () { return characterStyle.extractLabel(KEY); }, "")),
    objectStyle: String(read(function () { return objectStyle.extractLabel(KEY); }, ""))
  };
  result.roundTrip = roundTrip;
  result.displayLabel = String(read(function () { return frameA.label; }, ""));
  result.missingKeyRaw = read(function () { return frameA.extractLabel(KEY + ".missing"); }, null);

  const dupMatches = [];
  for (const frame of items(page.textFrames)) {
    if (String(read(function () { return frame.extractLabel(KEY); }, "")) === "probe-dup-slot") {
      dupMatches.push(String(frame.name));
    }
  }
  result.dupLabelMatchNames = dupMatches;
  result.dupLabelMatchCount = dupMatches.length;

  const heroMatches = [];
  for (const item of items(scratchDocument.pages.item(0).pageItems)) {
    if (String(read(function () { return item.extractLabel(KEY); }, "")) === "probe-hero-title") {
      heroMatches.push(String(item.name));
    }
  }
  result.uniqueLabelMatchNames = heroMatches;

  const expectedRoundTrip = {
    document: "probe-document",
    page: "probe-page-article",
    textFrameA: "probe-hero-title",
    textFrameB: "probe-dup-slot",
    textFrameC: "probe-dup-slot",
    paragraphStyle: "probe-style-body",
    characterStyle: "probe-style-emphasis",
    objectStyle: "probe-style-frame"
  };
  let roundTripOk = true;
  for (const field of Object.keys(expectedRoundTrip)) {
    if (roundTrip[field] !== expectedRoundTrip[field]) roundTripOk = false;
  }

  result.checks = {
    roundTrip: roundTripOk,
    uniqueLookup: heroMatches.length === 1 && heroMatches[0] === "ProbeUnique",
    duplicateLookupCount: dupMatches.length === 2
      && dupMatches[0] === "ProbeDup" && dupMatches[1] === "ProbeDup",
    displayLabel: result.displayLabel === "Probe Display Label"
  };
  result.success = result.checks.roundTrip
    && result.checks.uniqueLookup
    && result.checks.duplicateLookupCount
    && result.checks.displayLabel
    && result.keyIsolation === true;
} catch (error) {
  result.error = String(error && error.stack ? error.stack : error);
} finally {
  if (scratchDocument) {
    try {
      scratchDocument.close(SaveOptions.NO);
      result.scratchDocumentClosed = true;
    } catch (error) {
      result.scratchDocumentClosed = false;
      result.closeError = String(error && error.stack ? error.stack : error);
    }
  } else {
    result.scratchDocumentClosed = false;
  }

  result.openDocumentCountAfter = app.documents.length;
  result.success = result.success
    && result.scratchDocumentClosed
    && result.openDocumentCountAfter === result.openDocumentCountBefore;
  console.log("FOLIO_LABEL_INMEMORY_PROBE_V2 " + JSON.stringify(result));
}
