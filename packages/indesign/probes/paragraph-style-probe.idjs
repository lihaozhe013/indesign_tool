const { app, SaveOptions } = require("indesign");

const result = {
  probeVersion: 1,
  capability: "paragraph-style-create-and-apply",
  hostVersion: String(app.version),
  domVersion: String(app.scriptPreferences.version),
  openDocumentCountBefore: app.documents.length,
  success: false
};

let scratchDocument;

try {
  scratchDocument = app.documents.add();
  const textFrame = scratchDocument.pages.item(0).textFrames.add({
    geometricBounds: [36, 36, 72, 360]
  });
  textFrame.contents = "Paragraph style probe";

  const styleName = "Folio Probe Body";
  const createdStyle = scratchDocument.paragraphStyles.add({ name: styleName });
  const paragraph = textFrame.parentStory.paragraphs.item(0);
  paragraph.applyParagraphStyle(createdStyle, true);

  result.createdStyleName = createdStyle.name;
  result.appliedStyleName = paragraph.appliedParagraphStyle.name;
  result.paragraphContents = String(paragraph.contents);
  result.success = result.createdStyleName === styleName
    && result.appliedStyleName === styleName
    && result.paragraphContents.indexOf("Paragraph style probe") >= 0;
} catch (error) {
  result.error = String(error && error.stack ? error.stack : error);
} finally {
  if (scratchDocument) {
    try {
      scratchDocument.close(SaveOptions.NO);
      result.scratchDocumentClosed = true;
    } catch (error) {
      result.scratchDocumentClosed = false;
      result.closeError = String(error && error.stack ? error.stack : error);
    }
  } else {
    result.scratchDocumentClosed = false;
  }

  result.openDocumentCountAfter = app.documents.length;
  result.success = result.success
    && result.scratchDocumentClosed
    && result.openDocumentCountAfter === result.openDocumentCountBefore;
  console.log("FOLIO_PARAGRAPH_STYLE_PROBE_V1 " + JSON.stringify(result));
}
