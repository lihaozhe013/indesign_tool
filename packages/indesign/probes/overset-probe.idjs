const { app, SaveOptions } = require("indesign");

// One capability: force overset in a deliberately small frame, add flow
// capacity by threading a second frame, and confirm the host recomposes the
// story without losing source text. Records the before/after overset state
// and the composed split between the two frames.
const PARAGRAPHS = [];
for (let index = 1; index <= 40; index += 1) {
  PARAGRAPHS.push("第" + index + "段：用于制造溢出的中文长文本内容 with English words.");
}
const STORY_TEXT = PARAGRAPHS.join("\r");

function read(readValue, fallback) {
  try {
    const value = readValue();
    return value === undefined || value === null ? fallback : value;
  } catch (_error) {
    return fallback;
  }
}

const result = {
  probeVersion: 1,
  capability: "story-overset-and-reflow",
  hostVersion: String(app.version),
  domVersion: String(app.scriptPreferences.version),
  openDocumentCountBefore: app.documents.length,
  sourceParagraphCount: PARAGRAPHS.length,
  sourceCharacterCount: STORY_TEXT.length,
  success: false
};

let scratchDocument;

try {
  scratchDocument = app.documents.add();
  const page = scratchDocument.pages.item(0);
  const smallFrame = page.textFrames.add({ geometricBounds: [36, 36, 80, 400] });
  smallFrame.contents = STORY_TEXT;
  const story = smallFrame.parentStory;

  result.before = {
    overflows: read(function () { return story.overflows; }, null),
    characterCount: story.characters.length,
    paragraphCount: story.paragraphs.length,
    textPreserved: String(story.contents) === STORY_TEXT
  };

  const overflowFrame = page.textFrames.add({ geometricBounds: [100, 36, 700, 400] });
  smallFrame.nextTextFrame = overflowFrame;

  result.after = {
    overflows: read(function () { return story.overflows; }, null),
    characterCount: story.characters.length,
    paragraphCount: story.paragraphs.length,
    textPreserved: String(story.contents) === STORY_TEXT,
    textContainerCount: read(function () { return story.textContainers.length; }, null),
    firstFrameCharacters: String(smallFrame.contents).length,
    secondFrameCharacters: String(overflowFrame.contents).length
  };
  result.sameStory = read(function () { return smallFrame.parentStory.id; }, null)
    === read(function () { return overflowFrame.parentStory.id; }, null);

  result.checks = {
    oversetBefore: result.before.overflows === true,
    clearAfterThreading: result.after.overflows === false,
    textPreserved: result.before.textPreserved && result.after.textPreserved,
    charactersUnchanged: result.before.characterCount === result.after.characterCount
      && result.after.characterCount === STORY_TEXT.length,
    sharedStory: result.sameStory
  };
  result.success = Object.keys(result.checks).every(function (key) { return result.checks[key] === true; });
} catch (error) {
  result.error = String(error && error.stack ? error.stack : error);
} finally {
  if (scratchDocument) {
    try {
      scratchDocument.close(SaveOptions.NO);
      result.scratchDocumentClosed = true;
    } catch (error) {
      result.scratchDocumentClosed = false;
      result.closeError = String(error && error.stack ? error.stack : error);
    }
  } else {
    result.scratchDocumentClosed = false;
  }
  result.openDocumentCountAfter = app.documents.length;
  result.success = result.success
    && result.scratchDocumentClosed
    && result.openDocumentCountAfter === result.openDocumentCountBefore;
  console.log("FOLIO_OVERSET_PROBE_V1 " + JSON.stringify(result));
}