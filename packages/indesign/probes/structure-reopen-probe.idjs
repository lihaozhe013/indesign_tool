const { app, SaveOptions } = require("indesign");

// Phase 2 of the structure-persistence claim, run in its own execution after
// structure-save-probe.idjs: reopen the saved document and verify that pages,
// parent-page identity, the adopted parent flow frame, the threaded main
// story, named styles, and stable object ids all survived. Closes without
// saving.
//
// The main story is located by its contents rather than by assuming a page:
// page ownership of a frame follows its geometric bounds, so frames can land
// on the neighboring page of a spread.
const ROLE_KEY = "com.publisher.role";
const SCRATCH_FILE = "/Users/lihaozhe/dev/indesign_tool/artifacts/host/indesign-21.0.0.192/structure-persist/scratch-structure.indd";
const SCRATCH_NAME = "scratch-structure.indd";
const STRUCTURE_TEXT = [
  "结构持久化第一段：中文内容与 English 混排。",
  "结构持久化第二段：用于验证样式与串接关系在重开后保持。",
  "结构持久化第三段：结束。"
].join("\r");

function read(readValue, fallback) {
  try {
    const value = readValue();
    return value === undefined || value === null ? fallback : value;
  } catch (_error) {
    return fallback;
  }
}

function items(collection) {
  const output = [];
  for (let index = 0; index < collection.length; index += 1) {
    output.push(typeof collection.item === "function" ? collection.item(index) : collection[index]);
  }
  return output;
}

function findRoleFrames(frames, role) {
  return items(frames).filter(function (frame) {
    return String(read(function () { return frame.extractLabel(ROLE_KEY); }, "")) === role;
  });
}

async function settled(value) {
  return value && typeof value.then === "function" ? await value : value;
}

const result = {
  probeVersion: 4,
  capability: "structure-reopen",
  hostVersion: String(app.version),
  domVersion: String(app.scriptPreferences.version),
  openDocumentCountBefore: app.documents.length,
  scratchFile: SCRATCH_FILE,
  success: false
};

(async function main() {
  let document;
  try {
    let alreadyOpen = false;
    for (const open of items(app.documents)) {
      if (String(read(function () { return open.name; }, "")) === SCRATCH_NAME) alreadyOpen = true;
    }
    if (alreadyOpen) {
      result.alreadyOpen = true;
      throw new Error(SCRATCH_NAME + " is already open; refusing memory-backed persistence evidence");
    }

    document = await settled(app.open(SCRATCH_FILE, true));
    const articlePage = document.pages.item(0);

    let story = null;
    for (const candidate of items(document.stories)) {
      if (String(read(function () { return candidate.contents; }, "")) === STRUCTURE_TEXT) {
        story = candidate;
        break;
      }
    }
    const containers = story ? items(story.textContainers) : [];
    const adoptedFlow = findRoleFrames(articlePage.textFrames, "probe-parent-article-flow")[0] ?? null;
    const paragraphStyle = document.paragraphStyles.itemByName("Folio Structure Body");
    const characterStyle = document.characterStyles.itemByName("Folio Structure Emphasis");

    result.reopened = {
      pageCount: document.pages.length,
      pageIds: items(document.pages).map(function (page) { return read(function () { return page.id; }, null); }),
      masterSpreadCount: document.masterSpreads.length,
      articlePageId: read(function () { return articlePage.id; }, null),
      articlePageAppliedMasterId: read(function () { return articlePage.appliedMaster.id; }, null),
      masterSpreadId: read(function () { return document.masterSpreads.item(0).id; }, null),
      adoptedFlowId: adoptedFlow ? read(function () { return adoptedFlow.id; }, null) : null,
      adoptedFlowLabel: adoptedFlow
        ? String(read(function () { return adoptedFlow.extractLabel(ROLE_KEY); }, "")) : null,
      adoptedFlowContents: adoptedFlow ? String(read(function () { return adoptedFlow.contents; }, "")) : null,
      storyCount: document.stories.length,
      storyFound: story !== null,
      storyId: story ? read(function () { return story.id; }, null) : null,
      paragraphCount: story ? story.paragraphs.length : null,
      paragraphStyleNames: story ? items(story.paragraphs).map(function (paragraph) {
        return String(read(function () { return paragraph.appliedParagraphStyle.name; }, ""));
      }) : [],
      characterStyleName: story && story.paragraphs.length > 1
        ? String(read(function () {
            return story.paragraphs.item(1).characters.item(0).appliedCharacterStyle.name;
          }, ""))
        : null,
      textContainerCount: containers.length,
      textContainerParentPageIds: containers.map(function (frame) {
        return read(function () { return frame.parentPage.id; }, null);
      }),
      textContainerIds: containers.map(function (frame) { return read(function () { return frame.id; }, null); }),
      threadChain: containers.length >= 2
        ? read(function () { return containers[0].nextTextFrame.id; }, null)
          === read(function () { return containers[1].id; }, null)
        : null,
      paragraphStyleId: read(function () { return paragraphStyle.id; }, null),
      characterStyleId: read(function () { return characterStyle.id; }, null),
      paragraphStyleValid: read(function () { return paragraphStyle.isValid; }, null),
      characterStyleValid: read(function () { return characterStyle.isValid; }, null),
      overflows: story ? read(function () { return story.overflows; }, null) : null
    };
    result.documentWideRoleFrameCount = findRoleFrames(document.allPageItems, "probe-parent-article-flow").length;

    result.checks = {
      pageCount: result.reopened.pageCount === 2,
      parentPagePersisted: result.reopened.articlePageAppliedMasterId !== null
        && result.reopened.articlePageAppliedMasterId === result.reopened.masterSpreadId,
      adoptedFlowPersisted: result.reopened.adoptedFlowLabel === "probe-parent-article-flow"
        && result.reopened.adoptedFlowContents === "Parent page frame text",
      storyFound: result.reopened.storyFound === true,
      textPreserved: story !== null && String(story.contents) === STRUCTURE_TEXT,
      threadingPersisted: result.reopened.textContainerCount === 2
        && result.reopened.threadChain === true,
      paragraphStylesPersisted: result.reopened.paragraphStyleNames.length === 3
        && result.reopened.paragraphStyleNames.every(function (name) { return name === "Folio Structure Body"; })
        && result.reopened.paragraphStyleValid === true,
      characterStylePersisted: result.reopened.characterStyleName === "Folio Structure Emphasis"
        && result.reopened.characterStyleValid === true
    };
    result.success = Object.keys(result.checks).every(function (key) { return result.checks[key] === true; });
  } catch (error) {
    result.error = String(error && error.stack ? error.stack : error);
  } finally {
    if (document) {
      try {
        await settled(document.close(SaveOptions.NO));
        result.reopenedDocumentClosed = true;
      } catch (error) {
        result.reopenedDocumentClosed = false;
        result.closeError = String(error && error.stack ? error.stack : error);
      }
    } else {
      result.reopenedDocumentClosed = false;
    }
    result.openDocumentCountAfter = app.documents.length;
    result.success = result.success
      && result.reopenedDocumentClosed
      && result.openDocumentCountAfter === result.openDocumentCountBefore;
    console.log("FOLIO_STRUCTURE_REOPEN_PROBE_V4 " + JSON.stringify(result));
  }
})();