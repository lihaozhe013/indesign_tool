const { app, SaveOptions } = require("indesign");

// One capability: define a named object style, apply it to a text frame, and
// read the style and a styled property back. Records which application call
// works (applyObjectStyle versus the appliedObjectStyle property).
const ROLE_KEY = "com.publisher.role";

function read(readValue, fallback) {
  try {
    const value = readValue();
    return value === undefined || value === null ? fallback : value;
  } catch (_error) {
    return fallback;
  }
}

const result = {
  probeVersion: 1,
  capability: "object-style-create-and-apply",
  hostVersion: String(app.version),
  domVersion: String(app.scriptPreferences.version),
  openDocumentCountBefore: app.documents.length,
  success: false
};

let scratchDocument;

try {
  scratchDocument = app.documents.add();
  const page = scratchDocument.pages.item(0);
  const pageBounds = read(function () { return page.bounds; }, [0, 0, 200, 200]);
  const frame = page.textFrames.add({
    geometricBounds: [pageBounds[0] + 20, pageBounds[1] + 20, pageBounds[0] + 80, pageBounds[3] - 20],
    contents: "Object style probe"
  });

  const style = scratchDocument.objectStyles.add({ name: "Publisher Probe Frame" });
  style.insertLabel(ROLE_KEY, "probe-object-style-frame");
  result.styleDefined = {
    name: String(read(function () { return style.name; }, "")),
    id: read(function () { return style.id; }, null),
    label: String(read(function () { return style.extractLabel(ROLE_KEY); }, ""))
  };

  let strokeWeightSet = null;
  let enableStrokeSet = null;
  try {
    style.enableStroke = true;
    enableStrokeSet = true;
  } catch (error) {
    enableStrokeSet = String(error && error.message ? error.message : error);
  }
  try {
    style.strokeWeight = 3;
    strokeWeightSet = read(function () { return style.strokeWeight; }, null);
  } catch (error) {
    strokeWeightSet = String(error && error.message ? error.message : error);
  }

  let applyObjectStyleResult = null;
  try {
    frame.applyObjectStyle(style, true);
    applyObjectStyleResult = "applyObjectStyle";
  } catch (error) {
    applyObjectStyleResult = "error: " + String(error && error.message ? error.message : error);
  }

  result.application = {
    called: applyObjectStyleResult,
    appliedStyleName: String(read(function () { return frame.appliedObjectStyle.name; }, "")),
    appliedStyleId: read(function () { return frame.appliedObjectStyle.id; }, null),
    frameStrokeWeight: read(function () { return frame.strokeWeight; }, null),
    frameEnableStroke: read(function () { return frame.enableStroke; }, null),
    frameContents: String(read(function () { return frame.contents; }, ""))
  };

  result.stylePropertySet = {
    enableStroke: enableStrokeSet,
    strokeWeight: strokeWeightSet
  };

  result.checks = {
    styleNamed: result.styleDefined.name === "Publisher Probe Frame",
    styleLabel: result.styleDefined.label === "probe-object-style-frame",
    styleAppliedById: result.application.appliedStyleId !== null
      && result.application.appliedStyleId === result.styleDefined.id,
    strokeWeightApplied: String(result.application.frameStrokeWeight) === String(style.strokeWeight),
    contentPreserved: result.application.frameContents === "Object style probe"
  };
  result.success = Object.keys(result.checks).every(function (key) { return result.checks[key] === true; });
} catch (error) {
  result.error = String(error && error.stack ? error.stack : error);
} finally {
  if (scratchDocument) {
    try {
      scratchDocument.close(SaveOptions.NO);
      result.scratchDocumentClosed = true;
    } catch (error) {
      result.scratchDocumentClosed = false;
      result.closeError = String(error && error.stack ? error.stack : error);
    }
  } else {
    result.scratchDocumentClosed = false;
  }
  result.openDocumentCountAfter = app.documents.length;
  result.success = result.success
    && result.scratchDocumentClosed
    && result.openDocumentCountAfter === result.openDocumentCountBefore;
  console.log("PUBLISHER_OBJECT_STYLE_PROBE_V1 " + JSON.stringify(result));
}