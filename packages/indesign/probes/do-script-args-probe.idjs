const { app } = require("indesign");

// Diagnostic: locate any do-script argument payload inside the wrapped
// script's `arguments` object. Records each index with type and a JSON view.

function view(value) {
  try {
    if (value === undefined) return "undefined";
    if (value === null) return "null";
    const type = typeof value;
    if (type === "string" || type === "number" || type === "boolean") return String(value);
    if (type === "function") return "function";
    return type + ":" + JSON.stringify(value);
  } catch (_error) {
    return "unreadable";
  }
}

const result = {
  probeVersion: 2,
  capability: "do-script-arguments",
  hostVersion: String(app.version),
  success: true
};

try {
  const list = [];
  for (let index = 0; index < arguments.length; index += 1) {
    list.push({ index: index, type: typeof arguments[index], value: view(arguments[index]) });
  }
  result.argumentList = list;
  result.rawLength = arguments.length;
} catch (error) {
  result.argumentsError = String(error && error.message ? error.message : error);
}

console.log("PUBLISHER_DO_SCRIPT_ARGS_PROBE_V2 " + JSON.stringify(result));