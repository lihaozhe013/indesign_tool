{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "composite": true
  },
  "references": [
    { "path": "../contracts" },
    { "path": "../core" },
    { "path": "../template" },
    { "path": "../indesign" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/i18n/locales/*.json"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
